desc: Gain control
//tags: gain

dB:-8<-30,15,1>Volume gain (dB)

// Runtime adapter: @init owns buffers/history; @slider updates parameters only.
@init
dB = -8;
DB_2_LOG = 0.11512925464970228420089957273422;

@slider
gainLin = exp(dB * DB_2_LOG);

@sample
spl0 = spl0 * gainLin;
spl1 = spl1 * gainLin;
