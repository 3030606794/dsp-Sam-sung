    <string name="peq_resize_add_back">从后端增加</string>
    <string name="peq_resize_remove_front">从前端删除</string>
    <string name="peq_resize_remove_back">从后端删除</string>
    <string name="peq_resize_add_front_summary">在列表最前面增加 %1$d 段，原有频段顺序保持不变。</string>
    <string name="peq_resize_add_back_summary">在列表最后面增加 %1$d 段，原有频段顺序保持不变。</string>
    <string name="peq_resize_remove_front_summary">删除列表最前面的 %1$d 段，保留其余频段。</string>
    <string name="peq_resize_remove_back_summary">删除列表最后面的 %1$d 段，保留其余频段。</string>
