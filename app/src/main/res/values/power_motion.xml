    <string name="power_motion_style_wave_summary">Full-frequency impact · Waves expand across the full screen when enabled and draw back to the power button when disabled.</string>
    <string name="power_motion_style_spectrum_summary">Spectrum wall · Frequency bands rise to fill the screen when enabled and gather back into the power button when disabled.</string>
    <string name="power_motion_style_phase_summary">Phase interference · Two wave fields spread and intersect across the screen when enabled, then merge back into the power button when disabled.</string>
    <string name="power_motion_style_matrix_summary">Signal matrix · Signal paths light up across the screen when enabled and return to the power button when disabled.</string>
    <string name="power_motion_style_refraction_summary">Band refraction · Frequency blades unfold across the screen when enabled and fold back into the power button when disabled.</string>
    <string name="power_motion_style_dome_summary">Soundfield dome · A soundfield dome expands across the screen when enabled and contracts into the power button when disabled.</string>
</resources>
