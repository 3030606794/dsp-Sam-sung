<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/creative_capture" style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
        android:text="捕获并冻结" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/creative_release" style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
        android:text="释放冻结" />
</LinearLayout>
