<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">
    <TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceListItem" />
    <TextView android:id="@android:id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textAppearance="?android:attr/textAppearanceListItemSecondary" />
    <me.timschneeberger.rootlessjamesdsp.fusion.CrossfeedResponseView android:id="@+id/crossfeed_response_chart"
        android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginTop="8dp" />
</LinearLayout>
