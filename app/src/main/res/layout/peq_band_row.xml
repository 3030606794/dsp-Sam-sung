<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="1dp" android:layout_marginBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="6dp">
        <LinearLayout android:id="@+id/peq_band_header" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/peq_band_title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView android:id="@+id/peq_band_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
            <TextView android:id="@+id/peq_band_gain" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:paddingHorizontal="4dp"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_edit"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="12dp"
                android:contentDescription="@string/peq_edit_band"
                app:icon="@drawable/ic_twotone_settings_24dp" app:iconPadding="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/peq_gain_controls" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_minus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="−" android:textSize="24sp" android:contentDescription="@string/peq_gain_decrease" />
            <com.google.android.material.slider.Slider android:id="@+id/peq_band_slider"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                app:labelBehavior="floating" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_plus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="+" android:textSize="24sp" android:contentDescription="@string/peq_gain_increase" />
        </LinearLayout>
        <LinearLayout android:id="@+id/peq_q_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/peq_q_value" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_q_minus"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                    android:text="−" android:textSize="24sp" android:contentDescription="@string/peq_quality_decrease" />
                <com.google.android.material.slider.Slider android:id="@+id/peq_q_slider"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:contentDescription="@string/peq_quality" app:labelBehavior="floating" />
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_q_plus"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                    android:text="+" android:textSize="24sp" android:contentDescription="@string/peq_quality_increase" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/peq_frequency_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/peq_frequency_value" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_frequency_minus"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                    android:text="−" android:textSize="24sp" android:contentDescription="@string/peq_frequency_decrease" />
                <com.google.android.material.slider.Slider android:id="@+id/peq_frequency_slider"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:contentDescription="@string/peq_frequency" app:labelBehavior="floating" />
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_frequency_plus"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                    android:text="+" android:textSize="24sp" android:contentDescription="@string/peq_frequency_increase" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
