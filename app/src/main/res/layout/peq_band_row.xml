<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="1dp" android:layout_marginBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="4dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/peq_band_header" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="40dp">
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_column_1"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.2" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_column_2"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.4" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_column_3"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.6" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_column_4"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.8" />
            <TextView android:id="@+id/peq_band_title" android:layout_width="wrap_content"
                android:layout_height="40dp" android:gravity="center"
                android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp"
                app:layout_constrainedWidth="true" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/peq_column_1" app:layout_constraintTop_toTopOf="parent"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_drag_handle"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="40dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="4dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:contentDescription="@string/peq_reorder_band" android:tooltipText="@string/peq_reorder_band"
                app:layout_constraintStart_toStartOf="@id/peq_column_1"
                app:layout_constraintEnd_toStartOf="@id/peq_column_2" app:layout_constraintTop_toTopOf="parent"
                app:icon="@drawable/ic_peq_drag" app:iconPadding="0dp" app:iconSize="18dp" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_locate"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="24dp"
                android:layout_height="40dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="2dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:contentDescription="@string/peq_locate_band"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:icon="@drawable/ic_peq_locate_24" app:iconPadding="0dp" app:iconSize="20dp" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_warning"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="40dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="!" android:textSize="18sp" android:textColor="?attr/colorError"
                android:visibility="invisible" android:contentDescription="@string/peq_frequency_unset_warning"
                app:layout_constraintStart_toEndOf="@id/peq_band_locate"
                app:layout_constraintEnd_toStartOf="@id/peq_column_3" app:layout_constraintWidth_max="16dp"
                app:layout_constraintHorizontal_bias="0" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/peq_band_gain" android:layout_width="0dp"
                android:layout_height="40dp" android:gravity="center" android:paddingHorizontal="1dp"
                android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp"
                app:layout_constraintStart_toStartOf="@id/peq_column_3"
                app:layout_constraintEnd_toStartOf="@id/peq_column_4" app:layout_constraintTop_toTopOf="parent"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_edit"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="32dp"
                android:layout_height="40dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="4dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:contentDescription="@string/peq_edit_band"
                app:layout_constraintStart_toStartOf="@id/peq_column_4" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:icon="@drawable/ic_twotone_settings_24dp" app:iconPadding="0dp" app:iconGravity="textStart" />
            <LinearLayout android:id="@+id/peq_band_details" android:layout_width="0dp"
                android:layout_height="wrap_content" android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/peq_column_2"
                app:layout_constraintTop_toBottomOf="@id/peq_band_title">
                <TextView android:id="@+id/peq_band_header_frequency" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
                <TextView android:id="@+id/peq_band_detail_separator" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=" · "
                    android:importantForAccessibility="no" android:textAppearance="?attr/textAppearanceBodySmall" />
                <TextView android:id="@+id/peq_band_summary" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="24dp"
                    android:gravity="center_vertical" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true" android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout android:id="@+id/peq_gain_controls" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_minus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="−" android:textSize="24sp" android:contentDescription="@string/peq_gain_decrease" />
            <com.google.android.material.slider.Slider android:id="@+id/peq_band_slider"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                app:labelBehavior="floating" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_plus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:text="+" android:textSize="24sp" android:contentDescription="@string/peq_gain_increase" />
        </LinearLayout>
        <LinearLayout android:id="@+id/peq_q_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/peq_q_value" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_q_minus"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                    android:text="−" android:textSize="24sp" android:contentDescription="@string/peq_quality_decrease" />
                <com.google.android.material.slider.Slider android:id="@+id/peq_q_slider"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:contentDescription="@string/peq_quality" app:labelBehavior="floating" />
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_q_plus"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                    android:text="+" android:textSize="24sp" android:contentDescription="@string/peq_quality_increase" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/peq_frequency_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/peq_frequency_value" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_frequency_minus"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                    android:text="−" android:textSize="24sp" android:contentDescription="@string/peq_frequency_decrease" />
                <com.google.android.material.slider.Slider android:id="@+id/peq_frequency_slider"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:contentDescription="@string/peq_frequency" app:labelBehavior="floating" />
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_frequency_plus"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="40dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                    android:text="+" android:textSize="24sp" android:contentDescription="@string/peq_frequency_increase" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
