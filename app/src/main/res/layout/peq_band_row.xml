<?xml version="1.0" encoding="utf-8"?>
<me.timschneeberger.rootlessjamesdsp.peq.PeqBandCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="1dp" android:layout_marginBottom="6dp" android:clipToOutline="true"
    app:cardUseCompatPadding="false" app:cardPreventCornerOverlap="false" app:contentPadding="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/peq_band_header" android:layout_width="match_parent"
            android:layout_height="40dp">
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_header_edge_1"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.111111111" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_header_edge_2"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.222222222" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_header_edge_3"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.333333333" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_header_edge_4"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.444444444" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_header_edge_5"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.555555556" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_header_edge_6"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.666666667" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_header_edge_7"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.777777778" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/peq_header_edge_8"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                app:layout_constraintGuide_percent="0.888888889" />
            <TextView android:id="@+id/peq_band_number" android:layout_width="0dp"
                android:layout_height="0dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold"
                android:background="@drawable/peq_band_number_background" android:textColor="?attr/colorOnSecondaryContainer"
                android:clickable="true" android:focusable="true" android:contentDescription="@string/peq_edit_band"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="@id/peq_header_edge_1"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_delete"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="4dp"
                android:insetTop="0dp" android:insetBottom="0dp" app:backgroundTint="@android:color/transparent"
                android:contentDescription="@string/peq_delete_band_action" android:tooltipText="@string/peq_delete_band_action"
                app:icon="@drawable/ic_twotone_delete_24dp" app:iconPadding="0dp" app:iconSize="20dp" app:iconGravity="textStart" app:iconTint="#D32F2F"
                app:layout_constraintStart_toStartOf="@id/peq_header_edge_1" app:layout_constraintEnd_toEndOf="@id/peq_header_edge_2"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <TextView android:id="@+id/peq_band_title" android:layout_width="0dp"
                android:layout_height="0dp" android:gravity="center" android:paddingHorizontal="1dp"
                android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:layout_constraintStart_toStartOf="@id/peq_header_edge_2" app:layout_constraintEnd_toEndOf="@id/peq_header_edge_3"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_warning"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="!" android:textSize="16sp" android:textColor="#D32F2F"
                android:visibility="invisible" android:contentDescription="@string/peq_frequency_unset_warning"
                app:layout_constraintStart_toStartOf="@id/peq_header_edge_3" app:layout_constraintEnd_toEndOf="@id/peq_header_edge_4"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_power"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="4dp"
                android:insetTop="0dp" android:insetBottom="0dp" app:backgroundTint="@android:color/transparent"
                android:contentDescription="@string/peq_disable_band" android:tooltipText="@string/peq_disable_band"
                app:icon="@drawable/ic_twotone_power_settings_24dp" app:iconPadding="0dp" app:iconSize="24dp" app:iconGravity="textStart"
                app:layout_constraintStart_toStartOf="@id/peq_header_edge_4" app:layout_constraintEnd_toEndOf="@id/peq_header_edge_5"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_drag_handle"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="4dp"
                android:insetTop="0dp" android:insetBottom="0dp" app:backgroundTint="@android:color/transparent"
                android:contentDescription="@string/peq_reorder_band" android:tooltipText="@string/peq_reorder_band"
                app:icon="@drawable/ic_peq_drag" app:iconPadding="0dp" app:iconSize="20dp" app:iconGravity="textStart"
                app:layout_constraintStart_toStartOf="@id/peq_header_edge_5" app:layout_constraintEnd_toEndOf="@id/peq_header_edge_6"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_locate"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="4dp"
                android:insetTop="0dp" android:insetBottom="0dp" app:backgroundTint="@android:color/transparent"
                android:contentDescription="@string/peq_locate_band" android:tooltipText="@string/peq_locate_band"
                app:icon="@drawable/ic_peq_locate_24" app:iconPadding="0dp" app:iconSize="20dp" app:iconGravity="textStart"
                app:layout_constraintStart_toStartOf="@id/peq_header_edge_6" app:layout_constraintEnd_toEndOf="@id/peq_header_edge_7"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <TextView android:id="@+id/peq_band_new" android:layout_width="0dp"
                android:layout_height="0dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold"
                android:text="@string/peq_new_band_badge" android:textColor="#2EAA53" android:visibility="invisible"
                app:layout_constraintStart_toStartOf="@id/peq_header_edge_7" app:layout_constraintEnd_toEndOf="@id/peq_header_edge_8"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_lock"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                android:layout_height="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="4dp"
                android:insetTop="0dp" android:insetBottom="0dp" app:backgroundTint="@android:color/transparent"
                android:contentDescription="@string/peq_unlock_band" android:tooltipText="@string/peq_unlock_band"
                app:icon="@drawable/ic_peq_lock" app:iconPadding="0dp" app:iconSize="20dp" app:iconGravity="textStart"
                app:layout_constraintStart_toStartOf="@id/peq_header_edge_8" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View android:id="@+id/peq_band_divider" android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/peq_band_details" android:layout_width="match_parent"
            android:layout_height="32dp" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/peq_band_header_frequency" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <TextView android:id="@+id/peq_band_detail_separator" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text=" · "
                android:importantForAccessibility="no" android:textAppearance="?attr/textAppearanceBodySmall" />
            <TextView android:id="@+id/peq_band_summary" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:gravity="center_vertical" android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true" android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
        <LinearLayout android:id="@+id/peq_gain_controls" android:layout_width="match_parent" android:layout_height="40dp"
            android:paddingHorizontal="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/peq_gain_label" android:layout_width="42dp" android:layout_height="match_parent"
                android:gravity="center" android:maxLines="1" android:text="@string/peq_gain"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_minus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="−" android:textSize="20sp" android:contentDescription="@string/peq_gain_decrease" />
            <com.google.android.material.slider.Slider android:id="@+id/peq_band_slider"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                app:thumbRadius="8dp" app:haloRadius="12dp" app:trackHeight="3dp" app:labelBehavior="floating" />
            <TextView android:id="@+id/peq_band_gain" android:layout_width="74dp" android:layout_height="32dp"
                android:layout_marginHorizontal="2dp" android:paddingHorizontal="2dp" android:gravity="center"
                android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
                android:background="@android:color/transparent" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_band_plus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="+" android:textSize="20sp" android:contentDescription="@string/peq_gain_increase" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_gain_lock"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="5dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                app:icon="@drawable/ic_peq_lock_open" app:iconSize="18dp" app:iconPadding="0dp" app:iconGravity="textStart" />
        </LinearLayout>
        <LinearLayout android:id="@+id/peq_q_controls" android:layout_width="match_parent" android:layout_height="40dp"
            android:paddingHorizontal="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/peq_q_label" android:layout_width="42dp" android:layout_height="match_parent"
                android:gravity="center" android:maxLines="1" android:text="@string/peq_quality"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_q_minus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="−" android:textSize="20sp" android:contentDescription="@string/peq_quality_decrease" />
            <com.google.android.material.slider.Slider android:id="@+id/peq_q_slider"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                app:thumbRadius="8dp" app:haloRadius="12dp" app:trackHeight="3dp" app:labelBehavior="floating" />
            <TextView android:id="@+id/peq_q_value" android:layout_width="74dp" android:layout_height="32dp"
                android:layout_marginHorizontal="2dp" android:paddingHorizontal="2dp" android:gravity="center"
                android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
                android:background="@android:color/transparent" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_q_plus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="+" android:textSize="20sp" android:contentDescription="@string/peq_quality_increase" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_q_lock"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="5dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                app:icon="@drawable/ic_peq_lock_open" app:iconSize="18dp" app:iconPadding="0dp" app:iconGravity="textStart" />
        </LinearLayout>
        <LinearLayout android:id="@+id/peq_frequency_controls" android:layout_width="match_parent" android:layout_height="40dp"
            android:paddingHorizontal="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/peq_frequency_label" android:layout_width="42dp" android:layout_height="match_parent"
                android:gravity="center" android:maxLines="1" android:text="@string/peq_card_frequency_label"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_frequency_minus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="−" android:textSize="20sp" android:contentDescription="@string/peq_frequency_decrease" />
            <com.google.android.material.slider.Slider android:id="@+id/peq_frequency_slider"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                app:thumbRadius="8dp" app:haloRadius="12dp" app:trackHeight="3dp" app:labelBehavior="floating" />
            <TextView android:id="@+id/peq_frequency_value" android:layout_width="74dp" android:layout_height="32dp"
                android:layout_marginHorizontal="2dp" android:paddingHorizontal="2dp" android:gravity="center"
                android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
                android:background="@android:color/transparent" android:clickable="true" android:focusable="true"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_frequency_plus"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="+" android:textSize="20sp" android:contentDescription="@string/peq_frequency_increase" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_frequency_lock"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="5dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                app:icon="@drawable/ic_peq_lock_open" app:iconSize="18dp" app:iconPadding="0dp" app:iconGravity="textStart" />
        </LinearLayout>
        <me.timschneeberger.rootlessjamesdsp.peq.PeqInlineFilterRow
            android:id="@+id/peq_inline_filter" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
</me.timschneeberger.rootlessjamesdsp.peq.PeqBandCardView>
