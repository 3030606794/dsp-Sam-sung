<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragment.DspFragment"
    tools:ignore="SpeakableTextPresentCheck">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pinned_output_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/card_device_profiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/card_output_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dsp_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        android:paddingTop="0dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_equalizers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/card_eq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/card_geq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/card_dynamic_peq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_ms_eq" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_match_eq" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/group_bass_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_bass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_bass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_sub_bass" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_low_phase" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/group_clarity_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_clarity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_spectrum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/group_spatial_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_diff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_stereowide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_surround"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_microshift" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/group_crossfeed_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_cure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_crossfeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_headtrack" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/group_reverb_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_reverb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_reverb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_shimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_gated_reverb" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_pingpong" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Creative delay and sustained textures share a card; Shimmer stays with reverbs. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_creative_textures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:id="@+id/group_creative_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/card_granular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/card_freeze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/group_analog_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_tube"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_analog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_tube"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_tape" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/group_dynamics_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/viper_effect_dynamic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_compressor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_transient" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_resonance" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_fusion_tone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_loudness" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_smart_adapt" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/group_advanced_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_speaker_optimization"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_ddc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_convolver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/card_liveprog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/card_expansion_voice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="1dp" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_formant" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_frequency_shift" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_vocoder" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_vocal" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/card_expansion_modulation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="1dp" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_auto_wah" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_autopan" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/card_expansion_repair" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="1dp" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_dereverb" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_declick" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.fragment.app.FragmentContainerView android:id="@+id/card_expansion_dehum" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
