<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:orientation="vertical"
    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
    android:paddingHorizontal="12dp" android:paddingVertical="12dp">
    <TextView android:id="@+id/peq_preset_row_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:maxLines="2" android:ellipsize="end" android:importantForAccessibility="no" />
    <TextView android:id="@+id/peq_preset_row_count"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall"
        android:importantForAccessibility="no" />
</LinearLayout>
