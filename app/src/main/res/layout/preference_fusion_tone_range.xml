<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:textColor="?android:attr/textColorPrimary" />
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/fusion_tone_range_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fusion_tone_range_small"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:text="±20"
            android:contentDescription="@string/fusion_tone_range_small" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fusion_tone_range_medium"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:text="±40"
            android:contentDescription="@string/fusion_tone_range_medium" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fusion_tone_range_large"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:text="±100"
            android:contentDescription="@string/fusion_tone_range_large" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
