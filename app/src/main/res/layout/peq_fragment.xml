<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingTop="2dp">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/peq_scroll_container" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/peq_response_appbar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@android:color/transparent"
            android:stateListAnimator="@null" app:elevation="0dp" app:liftOnScroll="false">
            <LinearLayout android:id="@+id/peq_response_header"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/peq_response_card"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp" app:cardPreventCornerOverlap="false"
                    app:cardUseCompatPadding="false" app:contentPadding="0dp">
                    <me.timschneeberger.rootlessjamesdsp.peq.PeqResponseView
                        android:id="@+id/peq_curve" android:layout_width="match_parent"
                        android:layout_height="@dimen/peq_curve_height" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/peq_add_front"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="2dp"
                        android:textSize="11sp" android:text="@string/peq_add_front" android:maxLines="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/peq_edit_selection"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp"
                        android:paddingHorizontal="2dp" android:textSize="12sp" android:maxLines="1"
                        android:text="@string/peq_edit_selection" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/peq_add_back"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="2dp"
                        android:textSize="11sp" android:text="@string/peq_add_back" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/peq_band_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:clipToPadding="false" android:paddingBottom="8dp" android:paddingHorizontal="11dp" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout android:id="@+id/peq_selection_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"
        android:paddingHorizontal="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/peq_selection_count" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_selection_all"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="56dp"
                android:layout_height="36dp" android:minHeight="0dp" android:minWidth="0dp"
                android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                android:textSize="12sp" android:text="@string/peq_selection_all" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_selection_none"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="56dp"
                android:layout_height="36dp" android:minHeight="0dp" android:minWidth="0dp"
                android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                android:textSize="12sp" android:text="@string/peq_selection_none" />
            <com.google.android.material.button.MaterialButton android:id="@+id/peq_selection_done"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp"
                android:layout_height="36dp" android:minHeight="0dp" android:minWidth="0dp"
                android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                android:textSize="12sp" android:text="@string/peq_selection_done" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/peq_selection_mode"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/peq_scope_selected">
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_scope_selected"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
                    android:paddingHorizontal="2dp" android:textSize="12sp" android:maxLines="1"
                    android:text="@string/peq_scope_selected" />
                <com.google.android.material.button.MaterialButton android:id="@+id/peq_scope_excluded"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
                    android:paddingHorizontal="2dp" android:textSize="12sp" android:maxLines="1"
                    android:text="@string/peq_scope_excluded" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:paddingHorizontal="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/peq_settings"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="0dp"
            android:paddingHorizontal="2dp" android:text="@string/peq_settings"
            android:textSize="12sp" android:maxLines="1"
            app:icon="@drawable/ic_tune_vertical_variant_24dp" app:iconSize="18dp" app:iconPadding="2dp" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton android:id="@+id/peq_reset"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="0dp"
            android:paddingHorizontal="2dp" android:textSize="12sp" android:maxLines="1" android:text="@string/peq_reset" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/peq_power"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:padding="8dp" android:scaleType="fitCenter" android:background="@android:color/transparent"
            android:contentDescription="@string/peq_power_off"
            app:srcCompat="@drawable/ic_twotone_power_settings_24dp"
            app:tint="@color/selector_floating_toggle_foreground_tint" />
        <com.google.android.material.button.MaterialButton android:id="@+id/peq_presets"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="0dp"
            android:paddingHorizontal="2dp" android:textSize="12sp" android:maxLines="1" android:text="@string/peq_presets" />
        <com.google.android.material.button.MaterialButton android:id="@+id/peq_parameters"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="0dp"
            android:paddingHorizontal="2dp" android:textSize="12sp" android:maxLines="1" android:text="@string/peq_parameters" />
    </LinearLayout>
</LinearLayout>
