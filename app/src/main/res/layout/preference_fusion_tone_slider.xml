<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:paddingStart="16dp" android:paddingEnd="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/fusion_tone_slider_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:maxLines="2" android:includeFontPadding="false" android:gravity="center_vertical" android:textAppearance="?android:attr/textAppearanceListItem" />
  <com.google.android.material.button.MaterialButton android:id="@id/slider_help" style="?attr/borderlessButtonStyle"
   android:layout_width="24dp" android:layout_height="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
   android:insetTop="0dp" android:insetBottom="0dp" android:text="?" android:textSize="16sp" android:includeFontPadding="false" android:gravity="center" />
  <TextView android:id="@+id/fusion_tone_keyword_left" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
  <TextView android:id="@+id/fusion_tone_keyword_right" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
  <com.google.android.material.button.MaterialButton android:id="@+id/fusion_tone_decrease" style="?attr/borderlessButtonStyle"
   android:layout_width="30dp" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="30dp" android:includeFontPadding="false" android:padding="0dp"
   android:insetTop="0dp" android:insetBottom="0dp" android:text="−" android:textSize="20sp" />
  <com.google.android.material.slider.Slider android:id="@+id/fusion_tone_slider" android:layout_width="0dp" android:layout_height="30dp"
   android:layout_weight="1" app:labelBehavior="floating" app:tickVisible="false"
   app:thumbRadius="6dp" app:thumbElevation="0dp" app:trackHeight="4dp" app:haloRadius="0dp" app:haloColor="@android:color/transparent" />
  <com.google.android.material.button.MaterialButton android:id="@+id/fusion_tone_increase" style="?attr/borderlessButtonStyle"
   android:layout_width="30dp" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="30dp" android:includeFontPadding="false" android:padding="0dp"
   android:insetTop="0dp" android:insetBottom="0dp" android:text="+" android:textSize="20sp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/fusion_tone_value" style="?attr/materialButtonOutlinedStyle"
   android:layout_width="84dp" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="30dp" android:includeFontPadding="false"
   android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="0dp" android:paddingBottom="0dp"
   android:insetTop="0dp" android:insetBottom="0dp" android:textSize="12sp" android:maxLines="1" android:gravity="center"
   app:autoSizeTextType="uniform" app:autoSizeMinTextSize="10sp" app:autoSizeMaxTextSize="12sp" />
 </LinearLayout>
</LinearLayout>
