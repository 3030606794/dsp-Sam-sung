<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    tools:context=".activity.GraphicEqualizerActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

        <FrameLayout android:layout_width="match_parent" android:layout_height="64dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:titleCentered="true" app:subtitleCentered="true"
            app:subtitleTextAppearance="@style/PeqToolbarSubtitle" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/peq_system_presets" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="76dp" android:layout_height="32dp"
            android:layout_gravity="top|start" android:layout_marginStart="56dp"
            android:layout_marginTop="2dp" android:minWidth="0dp" android:minHeight="0dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:paddingStart="2dp" android:paddingEnd="2dp"
            android:paddingTop="0dp" android:paddingBottom="0dp"
            android:includeFontPadding="false"
            android:textSize="13sp" android:text="@string/peq_system_presets" />
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <FrameLayout
                android:id="@+id/params"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
