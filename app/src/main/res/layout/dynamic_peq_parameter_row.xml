<?xml version="1.0" encoding="utf-8"?>
<!-- Copied from the original PEQ gain row; the label occupies the former lock+label space. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView android:id="@+id/dynamic_peq_parameter_label"
        android:layout_width="60dp" android:layout_height="match_parent"
        android:gravity="center" android:maxLines="1"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />
    <com.google.android.material.button.MaterialButton android:id="@id/dynamic_peq_parameter_minus"
        style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
        android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp"
        android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"
        android:text="−" android:textSize="20sp" />
    <com.google.android.material.slider.Slider android:id="@id/dynamic_peq_parameter_slider"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        app:thumbRadius="6dp" app:haloRadius="0dp" app:haloColor="@android:color/transparent"
        app:thumbElevation="0dp" app:trackHeight="4dp" app:labelBehavior="floating" />
    <TextView android:id="@id/dynamic_peq_parameter_value" android:layout_width="74dp" android:layout_height="32dp"
        android:layout_marginHorizontal="2dp" android:paddingHorizontal="2dp" android:gravity="center"
        android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:background="@android:color/transparent" android:clickable="true" android:focusable="true" />
    <com.google.android.material.button.MaterialButton android:id="@id/dynamic_peq_parameter_plus"
        style="@style/Widget.Material3.Button.TextButton" android:layout_width="28dp"
        android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp"
        android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"
        android:text="+" android:textSize="20sp" />
</merge>
